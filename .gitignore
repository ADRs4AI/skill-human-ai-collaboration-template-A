# macOS metadata
.DS_Store

# Temporary files
~*
temp

# Nested git repositories (source reference material — see ADR-0008)
# These are cloned repos kept locally for reference; not tracked by outer repo.
# Provenance: donor-repo (epistemic-arc-mapping) residue; its ADR-0008 on nested
# git repos did not travel to this template — 0008 here is a NEWCOMER's first number
docs/resources/reveal.js/reveal.js/
docs/resources/reveal.js/reveal.js-plugins/
docs/resources/reveal.js/revealjs.com/
docs/resources/automated-testing/playwright-mcp/

# Slides.com export lib/ bundles — large binary fonts, identical across exports
# Only track index.html and the presentation-specific assets folder per export
docs/resources/slides.com/*/lib/

# Playwright MCP session logs
.playwright-mcp/
# ADRs4AI extension working state (machine logs, local observations)
docs/adr/.working/
